# The VM image this app bundles: a release of https://github.com/afy0817/GodseonDongle-VM
# (GPL-2.0-or-later). app/build_app.sh downloads vm_assets.zip and checks its sha256;
# with --release it also fetches the image's corresponding source, vm_assets-sources.tar.gz,
# which goes into the app's GitHub release next to the app zip.
VM_ASSETS_VERSION=v0.1.0
VM_ASSETS_URL=https://github.com/afy0817/GodseonDongle-VM/releases/download/v0.1.0/vm_assets.zip
VM_ASSETS_SHA256=60425eab0db474f1a7483677b3c67be40ae03ab8f8c1dfb092a381ae2be84948
VM_SOURCES_URL=https://github.com/afy0817/GodseonDongle-VM/releases/download/v0.1.0/vm_assets-sources.tar.gz
VM_SOURCES_SHA256=7b25923fdd83bcf5bbdce4310a8931e8db4f373492a40cbd547c765bd61c6a52
